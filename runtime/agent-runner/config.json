{
  "version": 1,
  "scope": "life-manager",
  "timeout_seconds": 900,
  "providers": {
    "codex": {
      "executable": "~/.local/bin/codex",
      "executable_fallbacks": [
        "~/.local/bin/codex"
      ],
      "profiles": {
        "acct1": {
          "automation_home": "~/.local/state/life-manager/codex-runner/acct1",
          "auth_file": "~/.codex/auth.json"
        },
        "acct2": {
          "automation_home": "~/.local/state/life-manager/codex-runner/acct2",
          "auth_file": "~/.codex-acct2/auth.json"
        }
      },
      "account_profile_order": [
        "acct1",
        "acct2"
      ],
      "ssl_cert_file": "/etc/ssl/cert.pem",
      "project_doc_max_bytes": 0,
      "disabled_skills": [
        "imagegen",
        "openai-docs",
        "plugin-creator",
        "skill-creator",
        "skill-installer"
      ],
      "disabled_features": [
        "apps",
        "auth_elicitation",
        "goals",
        "hooks",
        "image_generation",
        "multi_agent",
        "plugins",
        "remote_plugin",
        "tool_call_mcp_elicitation",
        "tool_suggest",
        "workspace_dependencies"
      ],
      "capabilities": {
        "structured_json": true,
        "tools": true,
        "browser": true
      },
      "cost_tier": "subscription",
      "quota": {
        "source": "provider"
      }
    },
    "claude": {
      "executable": "claude",
      "executable_fallbacks": [
        "~/.local/bin/claude"
      ],
      "base_url": "http://127.0.0.1:8317",
      "auth_token_file": "~/.cli-proxy-api-key",
      "capabilities": {
        "structured_json": true,
        "tools": true,
        "browser": true
      },
      "cost_tier": "subscription",
      "quota": {
        "source": "provider"
      }
