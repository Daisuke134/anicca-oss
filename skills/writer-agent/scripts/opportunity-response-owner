#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
# shellcheck source=writer-runtime-env.sh
source "$ROOT/skills/writer-agent/scripts/writer-runtime-env.sh"
PYTHON="${LIFE_MANAGER_PYTHON:-$(command -v python3)}"
ACCOUNT="${WRITER_GMAIL_ACCOUNT:-${LIFE_MANAGER_GMAIL_ACCOUNT:-${GOG_ACCOUNT:-}}}"
: "${ACCOUNT:?WRITER_GMAIL_ACCOUNT or LIFE_MANAGER_GMAIL_ACCOUNT is required}"

exec "$PYTHON" "$ROOT/skills/writer-agent/scripts/opportunity_response.py" \
  --db "$STATE_DIR/opportunities.sqlite3" \
  --receipt "$STATE_DIR/opportunity-response-latest.json" \
  --account "$ACCOUNT" \
  "$@"
