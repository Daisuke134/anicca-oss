{
  "$schema": "earning-health-registry v2",
  "description": "One registry for required earning slots, their evidence probes, the existing trace-barren self-heal loop, and the four Life Manager portfolio rails. Every slot is instrumented. A healthy zero-demand rail remains operational; frozen and not-live are explicit states rather than instrumentation gaps.",
  "slots": [
    {
      "id": "earn/sol-trade",
      "instrumented": true,
      "traceFile": "sol-trade.trace.jsonl",
      "minRun": 20,
      "selfFixTarget": "sol-trade",
      "escalateEveryHrs": 24,
      "probe": {
        "kind": "trace",
        "tracePath": "skills/earn/state/sol-trade.trace.jsonl",
        "killPath": "skills/earn/sol-trade/KILL",
        "maxAgeSeconds": 10800
      }
    },
    {
      "id": "earn/polymarket-trade",
      "instrumented": true,
      "traceFile": "pm-trade.trace.jsonl",
      "minRun": 20,
      "selfFixTarget": "pm-trade",
      "escalateEveryHrs": 24,
      "probe": {
        "kind": "trace",
        "tracePath": "skills/earn/state/pm-trade.trace.jsonl",
        "killPath": ".local/state/life-manager/polymarket/KILL",
        "killPathBase": "home",
        "maxAgeSeconds": 10800
      }
    },
    {
      "id": "economy/gig",
      "instrumented": true,
      "traceFile": null,
      "minRun": 20,
      "selfFixTarget": "gig",
      "escalateEveryHrs": 24,
      "probe": {
        "kind": "launchd-ledger",
        "ledgerPaths": [
          "gig/storefront-direct/wakes.jsonl",
          "gig/apply-direct/wakes.jsonl"
        ],
        "launchdLabels": [
          "ai.anicca.hf-gig-apply-direct",
          "ai.anicca.hf-gig-reply-detector",
          "ai.anicca.hf-gig-paid-direct",
          "ai.anicca.hf-gig-storefront-direct"
        ],
        "maxAgeSeconds": 600
      }
    },
    {
      "id": "hl_trade",
      "instrumented": true,
      "traceFile": null,
      "minRun": 20,
      "selfFixTarget": "hl-trade",
      "escalateEveryHrs": 24,
      "probe": {
        "kind": "funded-account",
        "adapter": "hyperliquid"
      }
    },
    {
      "id": "x402_sell",
      "instrumented": true,
      "traceFile": null,
      "minRun": 20,
      "selfFixTarget": "x402-sell",
      "escalateEveryHrs": 24,
      "probe": {
        "kind": "http",
        "url": "https://anicca-x402-discovery-production.up.railway.app/health",
        "timeoutMs": 10000
      }
    },
    {
      "id": "token_launch",
      "instrumented": true,
      "traceFile": null,
      "minRun": 20,
      "selfFixTarget": "token-launch",
      "escalateEveryHrs": 24,
      "probe": {
        "kind": "explicit",
        "activationPath": "skills/earn/token-launch/LIVE"
      }
    }
  ],
  "portfolios": [
    {
      "id": "PM",
      "memberIds": [
        "earn/polymarket-trade"
      ]
    },
    {
      "id": "x402",
      "memberIds": [
        "x402_sell"
      ]
    },
    {
      "id": "WORK",
      "memberIds": [
        "economy/gig"
      ]
    },
    {
      "id": "CAPITAL",
      "memberIds": [
        "earn/polymarket-trade",
        "earn/sol-trade",
        "hl_trade",
        "token_launch"
      ]
    }
  ]
}
