# Anicca Configuration Template — copy to .env and fill in YOUR values
# (Never commit your actual .env to git)

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-YOUR-BOT-TOKEN-HERE
SLACK_APP_TOKEN=xapp-YOUR-APP-TOKEN-HERE
SLACK_REPORT_CHANNEL=C0XXXXXXXXX

# --- Gmail (gog CLI) ---
GOG_ACCOUNT=you@example.com
GOG_KEYRING_PASSWORD=your-keyring-password

# --- Anicca runtime ---
ANICCA_HOME=$HOME/.openclaw
ANICCA_HARNESS=claude-anicca

# --- Test harness ---
OSS_TEST_RECIPIENT=you@example.com
OSS_TEST_USER_NAME="Your Full Name"
OSS_TEST_USER_LOCATION="Your City"

# --- Writer publication identities (required only when enabling Writer) ---
# These identify accounts owned by this installation; never rely on project-author defaults.
NOTE_USER_ID=your-note-user-id
NOTE_URLNAME=your-note-urlname
NOTE_BROWSER_PROFILE_ID=note-publisher
ZENN_ACCOUNT=your-zenn-account
DEVTO_ACCOUNT_HANDLE=your-devto-handle
SUBSTACK_PUBLICATION_JA=your-japanese-publication.substack.com
SUBSTACK_PUBLICATION_EN=your-english-publication.substack.com
X_ACCOUNT_HANDLE=your-x-handle

# --- Writer product attribution (required only when enabling Writer publishing) ---
ARTICLE_PRODUCT_ID=your-product-id
ARTICLE_PRODUCT_LANDING_URL=https://example.com/
ARTICLE_SELF_OWNED_BASE_URL=https://example.com
ARTICLE_INTERNAL_LINK_URLS=https://example.com/docs
ARTICLE_CTA_URLS=https://example.com/

# --- Optional: Apple Dev (per-task creds) ---
# APPLE_ID=you@example.com
# APPLE_ID_PASSWORD=your-app-specific-password

# ═══════════════════════════════════════════════════════════════════════
# Personal life-leader stack (anicca-life-manager + 5 sibling skills)
# Required if you want phone wake calls / lateness alerts / gcal heal /
# travel-fill / weekly reports / payout. See docs/INSTALL_BOOTSTRAP.md
# for the install flow and ask order.
# ═══════════════════════════════════════════════════════════════════════

# --- Telegram (= bot you control via @BotFather, drives Live Location) ---
TELEGRAM_BOT_TOKEN=1234567890:YOUR-BOT-TOKEN
TELEGRAM_CHAT_ID=YOUR-TELEGRAM-CHAT-ID

# --- Google (= Maps Directions + Geocoding + Gemini Live voice LLM) ---
GOOGLE_API_KEY=AIzaYOUR-GOOGLE-API-KEY
GEMINI_API_KEY=AIzaYOUR-GEMINI-API-KEY

# --- Twilio (= the actual phone calls) ---
TWILIO_ACCOUNT_SID=ACYOUR-ACCOUNT-SID
TWILIO_AUTH_TOKEN=YOUR-AUTH-TOKEN
TWILIO_PHONE_NUMBER=+10000000000

# --- FUEL: pick exactly ONE of the four options below ---
# Option (1) Existing Claude / ChatGPT subscription (= no key needed,
# just `claude login` first then set HARNESS=claude-p)
# HARNESS=claude-p

# Option (2) API key from one of these providers
# HARNESS=openclaw
# ANTHROPIC_API_KEY=sk-ant-YOUR-KEY
# OPENAI_API_KEY=sk-YOUR-KEY
# DEEPSEEK_API_KEY=sk-YOUR-KEY
# KIMI_API_KEY=sk-YOUR-KEY

# Option (3) USDC wallet (= self-fund via x402, see scripts/fuel-usdc.sh)
# HARNESS=openclaw-x402
# WALLET_ADDR=0xYOUR-BASE-WALLET
# CDP_API_KEY_NAME=YOUR-CDP-KEY-NAME
# CDP_API_KEY_PRIVATE=YOUR-CDP-KEY-PRIVATE

# --- Pipecat phone (= dial-out endpoint URL inside the daemon) ---
ANICCA_PHONE_DIALOUT_URL=http://127.0.0.1:7860/dialout

# --- Optional: payout destination (= where Anicca sends your 10%) ---
# Tier 1 (= Stripe Connect Express, JPY bank, T+3-5 days, ~1% fee)
# STRIPE_SECRET_KEY=sk_live_YOUR-KEY
# STRIPE_CONNECT_PLATFORM_ID=acct_YOUR-PLATFORM
# Tier 2 (= Wise Platform, same-day JPY via Zengin, ~0.5-1.5% fee)
# WISE_API_TOKEN=YOUR-WISE-TOKEN
# WISE_PLATFORM_ID=YOUR-WISE-PROFILE
# Tier 3 = USDC wallet (= just paste it once into broker state; no key here)

# --- Optional: The402 earning provider ---
# Public HTTPS origin that forwards /webhooks/the402 to this instance.
# THE402_PUBLIC_URL=https://your-life-manager.example
# Directory containing the402-credentials.json and the402-service*.json.
# Defaults to ANICCA_HOME, then ~/.anicca.
# THE402_CONFIG_ROOT=$HOME/.local/state/life-manager/x402-sell/config

# --- Optional: where the daily / weekly Anicca reports get mailed ---
# defaults to GOG_ACCOUNT if unset
ANICCA_REPORT_TO=you@example.com

# --- Optional: tuning knobs (= sensible defaults shown for reference) ---
# LATE_LEAD_MIN=8                     # mins-to-depart threshold for call
# LATE_RACE_LOCK_SEC=60               # prevent double-dial within this window
# LATE_STALE_MIN=10                   # Telegram fix older than this = stale
# FUEL_PAYOUT_PERCENT=10              # % of net earnings to send the user
# TEMPLATE_FILL_WEEKENDS=0            # 1 to fill weekends with default routine
# TRAVEL_FILL_MIN_DIST_M=500          # min distance to trigger travel-block insert
# TRAVEL_FILL_MIN_GAP_MIN=10          # min gap between events to bother inserting
