#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
# shellcheck source=writer-runtime-env.sh
source "$ROOT/skills/writer-agent/scripts/writer-runtime-env.sh"
PYTHON="${LIFE_MANAGER_PYTHON:-$(command -v python3)}"

exec "$PYTHON" "$ROOT/skills/writer-agent/scripts/money_sync.py" \
  --state-dir "$STATE_DIR" \
  --db "$STATE_DIR/money.sqlite3" \
  "$@"
