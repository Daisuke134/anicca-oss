#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
PYTHON="${LIFE_MANAGER_PYTHON:-$HOME/.local/share/life-manager/venv/bin/python}"
STATE_ROOT="${LIFE_MANAGER_STATE_ROOT:?LIFE_MANAGER_STATE_ROOT is required}"

if [[ ! -x "$PYTHON" ]]; then
  echo "negotiate-owner: managed Python is unavailable: $PYTHON" >&2
  exit 69
fi

exec "$PYTHON" "$ROOT/skills/_shared/marketplace-core/scripts/reply_kernel.py" \
  --provider-adapter "$ROOT/skills/earn/lancers/scripts/reply_adapter.py" \
  --state-root "$STATE_ROOT/reply" \
  --output "$STATE_ROOT/reply/latest.json" \
  --max-workers 1 \
  -- --state-path "$STATE_ROOT/work-sync.json" \
  "$@"
