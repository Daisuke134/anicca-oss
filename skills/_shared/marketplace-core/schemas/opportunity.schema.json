{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anicca.ai/schemas/marketplace/opportunity-v1.json",
  "title": "MarketplaceOpportunity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "platform",
    "external_id",
    "title",
    "description",
    "url",
    "category",
    "budget_type",
    "budget_min_minor",
    "budget_max_minor",
    "currency",
    "buyer_external_id",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "record_type": {
      "const": "opportunity"
    },
    "platform": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{1,31}$(?![\\s\\S])"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!\\s)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$(?![\\s\\S])"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "budget_type": {
      "enum": [
        "fixed",
        "hourly",
        "contest",
        "bounty",
        "recruit",
        "unknown"
      ]
    },
    "budget_min_minor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_max_minor": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "buyer_external_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!\\s)[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F]$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
