#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
# shellcheck source=writer-runtime-env.sh
source "$ROOT/skills/writer-agent/scripts/writer-runtime-env.sh"
PYTHON="${LIFE_MANAGER_PYTHON:-$(command -v python3)}"

exec "$PYTHON" "$ROOT/skills/writer-agent/scripts/opportunity_discovery.py" \
  --db "$STATE_DIR/opportunities.sqlite3" \
  --claims-db "$STATE_DIR/claims.sqlite3" \
  --receipt "$STATE_DIR/opportunity-discovery-latest.json" \
  "$@"
